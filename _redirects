# The old Netlify address was shared publicly before the domain went live.
# Send every page on it to the same page on the real domain, so Google sees
# one site, not two copies. Deploy previews use other hostnames and are unaffected.
https://cashhardclub.netlify.app/*   https://cashhardclub.com/:splat   301!

# The Squarespace store moved off this domain when cashhardclub.com was
# pointed at Netlify. Until shop.cashhardclub.com is connected in
# Squarespace, every store path bounces to the store's built-in address —
# this keeps all Buy buttons and previously shared product links working.
# When the shop subdomain goes live, swap the host below and redeploy.
/store-MFHja      https://shopcashhardclub.squarespace.com/store-MFHja/merch  301
/store-MFHja/*    https://shopcashhardclub.squarespace.com/store-MFHja/:splat 301
/cart             https://shopcashhardclub.squarespace.com/cart               301
/cart/*           https://shopcashhardclub.squarespace.com/cart/:splat        301
/checkout         https://shopcashhardclub.squarespace.com/checkout           301
/checkout/*       https://shopcashhardclub.squarespace.com/checkout/:splat    301

# Short, typeable store links (the real store path is case-sensitive).
/shop             https://shopcashhardclub.squarespace.com/store-MFHja/merch  301
/store            https://shopcashhardclub.squarespace.com/store-MFHja/merch  301

# Order-status, customer-account and store-admin links in Squarespace emails
# still use this domain until the store's primary domain changes. Send them
# to the store too (same host swap as above at the cutover).
/account          https://shopcashhardclub.squarespace.com/account            301
/account/*        https://shopcashhardclub.squarespace.com/account/:splat     301
/commerce/*       https://shopcashhardclub.squarespace.com/commerce/:splat    301
/config           https://shopcashhardclub.squarespace.com/config             301
/config/*         https://shopcashhardclub.squarespace.com/config/:splat      301

# The old Squarespace homepage address, still listed in the store's sitemap.
/home             /                                                           301

# The mobile app source lives in a subdirectory of this repo and the Netlify publish
# directory is the repo root — keep the app tree and its internal docs off the public site.
# The trailing "!" forces the rule: without it Netlify serves the real file at the path
# and the rule never runs. The bare path is not matched by the splat, so it needs its own line.
/CashHardClub-App       /404.html   404!
/CashHardClub-App/*     /404.html   404!
/higgsfield-assets.md   /404.html   404!
